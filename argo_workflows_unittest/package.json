{
    "name": "argo-workflow-submit-action",
    "version": "1.0.0",
    "description": "GitHub Action para enviar workflows a Argo Workflows",
    "main": "dist/index.js",
    "scripts": {
      "build": "ncc build src/index.ts -o dist --source-map --minify",
      "lint": "eslint src/**/*.ts",
      "format": "prettier --write **/*.ts",
      "format-check": "prettier --check **/*.ts",
      "test": "jest",
      "all": "npm run build && npm run format && npm run lint && npm test"
    },
    "keywords": [
      "actions",
      "argo",
      "workflows",
      "zebrands",
      "kubernetes"
    ],
    "author": "ZeBrands DevOps",
    "license": "MIT",
    "dependencies": {
      "@actions/core": "^1.10.1",
      "axios": "^1.6.2"
    },
    "devDependencies": {
      "@types/jest": "^29.5.4",
      "@types/node": "^20.6.0",
      "@typescript-eslint/eslint-plugin": "^6.7.0",
      "@typescript-eslint/parser": "^6.7.0",
      "@vercel/ncc": "^0.38.0",
      "eslint": "^8.49.0",
      "eslint-plugin-github": "^4.10.0",
      "eslint-plugin-jest": "^27.4.0",
      "jest": "^29.7.0",
      "prettier": "^3.0.3",
      "ts-jest": "^29.1.1",
      "typescript": "^5.2.2"
    }
  }